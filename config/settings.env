# ==============================================================================
# Personal Library — central configuration
# ==============================================================================
# Every tunable setting for the Docker Compose stack lives here. Edit this file
# rather than hunting through docker-compose.yml.
#
# HOW VALUES ARE RESOLVED (highest priority wins):
#
#   1. A variable exported in your shell        (e.g. LIBRARY_DNS=1.2.3.4 npm run rebuild)
#   2. Your personal dotenv file in the project root, if present  — gitignored,
#      the right home for machine-specific or secret values
#   3. This file                                 — committed shared defaults
#   4. The `${VAR:-default}` fallback inside docker-compose.yml
#
# Levels 3 and 4 are kept identical on purpose, so a bare `docker compose up`
# (which reads neither this file nor any --env-file) still behaves exactly the
# same. `npm run config:check` enforces that and fails loudly if they drift.
#
# To apply a change made here, use the project's own entrypoints, which pass
# this file to Compose automatically:
#
#   npm run rebuild            # or any ops:/rebuild: script
#   npm run compose -- up -d   # plain Compose with the env chain wired up
#
# ==============================================================================


# ------------------------------------------------------------------------------
# Host ports
# ------------------------------------------------------------------------------
# These are the HOST side of each published port only; container-internal ports
# are deliberately left fixed, because nginx.conf and the inter-service URLs
# below address services by name and internal port.
#
# The non-default values are intentional: they keep this educational stack from
# colliding with a MongoDB, Qdrant, Ollama or Keycloak already running locally.
#
# NGINX_HTTP_PORT is the single recommended ingress. The two APP_* ports are
# direct-access bypasses used for development and by the UI's backend presets.
NGINX_HTTP_PORT=8088
APP_UI_PORT=13000
APP_BACKEND_PORT=18080
MONGO_PORT=37017
MONGO_EXPRESS_PORT=8091
STORAGE_BROWSER_PORT=8092
SWAGGER_EDITOR_PORT=8090
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
OLLAMA_PORT=21434
KEYCLOAK_PORT=8180


# ------------------------------------------------------------------------------
# Image versions
# ------------------------------------------------------------------------------
# Pinned so a rebuild is reproducible and an upstream release cannot silently
# change behaviour.
#
# Keep IMAGE_QDRANT's major/minor aligned with the Spring AI Qdrant client in
# pom.xml. A mismatch logs a client/server incompatibility warning at startup.
IMAGE_MONGO=mongo:7.0
IMAGE_MONGO_EXPRESS=mongo-express:1.0.2
IMAGE_NGINX=nginx:1.27-alpine
IMAGE_QDRANT=qdrant/qdrant:v1.18.0
IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:24.0.5
IMAGE_SWAGGER_EDITOR=swaggerapi/swagger-editor:v5.8.10
IMAGE_STORAGE_BROWSER=halverneus/static-file-server:v1.8.10
IMAGE_SEEDER=curlimages/curl:8.11.1

# Deliberately unpinned, unlike every image above: Ollama ships model-format and
# runtime fixes frequently, and this stack benefits from picking them up. The
# trade-off is that a rebuild can pull a different Ollama than last time, so if
# model loading ever breaks after an otherwise unrelated rebuild, pinning this
# to a known-good tag is the first thing to try.
IMAGE_OLLAMA=ollama/ollama:latest


# ------------------------------------------------------------------------------
# Credentials (local demo values)
# ------------------------------------------------------------------------------
# NOT SECRETS. This file is committed, and these exist so the stack starts with
# zero setup on a throwaway local environment. Each value was previously
# duplicated across several services, so changing one meant finding all of them.
#
# For anything reachable by someone other than you, override these in your
# personal dotenv file (gitignored) or the shell — never by editing this file.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=librarypass
MONGO_DATABASE=personal_library

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=personal-library-realm
KEYCLOAK_CLIENT_ID=personal-library-client
KEYCLOAK_CLIENT_SECRET=enterprise-library-secret


# ------------------------------------------------------------------------------
# AI models
# ------------------------------------------------------------------------------
# OLLAMA_PRELOAD_MODELS is pulled on first start and cached in the ollama_models
# volume. It is also what the ollama health check asserts is present, so the
# backend can never start against a missing model.
#
# It MUST contain the embedding model plus both chat models named below.
# nomic-embed-text produces 768-dimensional vectors; changing the embedding
# model changes that width, which means the Qdrant collection must be recreated
# (`npm run ops:factory-reset`, or delete the collection) — existing vectors are
# not convertible.
OLLAMA_PRELOAD_MODELS=nomic-embed-text llama3.2 mistral
OLLAMA_LLAMA_MODEL=llama3.2
OLLAMA_MISTRAL_MODEL=mistral


# ------------------------------------------------------------------------------
# Corporate network: DNS and proxy
# ------------------------------------------------------------------------------
# Containers do NOT use the host's /etc/resolv.conf — they inherit whatever
# resolver the Docker daemon hands out. If /etc/docker/daemon.json pins a public
# resolver that your network degrades or blocks, model pulls and the seeder's
# download fail while the host resolves names perfectly.
#
# The failure is usually intermittent rather than total, so a quick connectivity
# test passes while a multi-gigabyte model pull still dies partway through.
#
# Leave LIBRARY_DNS empty on a normal network: empty means "no override".
# scripts/rebuild.sh detects the mismatch and fills this in automatically for
# its own runs; set it here (or in your personal dotenv) so that a plain
# `docker compose up` benefits too:
#
#   grep nameserver /etc/resolv.conf
#
# See docs/DEVOPS_GUIDE.md §4.4.
LIBRARY_DNS=

# Outbound proxy for Ollama's model pulls. Leave empty when not behind one.
# ENTERPRISE_NO_PROXY must keep the internal service names, or container-to-
# container traffic would be sent to the proxy and fail.
ENTERPRISE_HTTP_PROXY=
ENTERPRISE_HTTPS_PROXY=
ENTERPRISE_NO_PROXY=localhost,127.0.0.1,qdrant,mongodb,keycloak


# ------------------------------------------------------------------------------
# Starter-document seeding
# ------------------------------------------------------------------------------
# On `docker compose up`, the one-shot library-seeder uploads every PDF in
# initial_data/ plus one remote document, so a fresh stack has something to
# search immediately. It is idempotent (documents already present are skipped)
# and non-fatal (no network must not fail the deployment).
#
# SEED_MAX_TIME is per document and generous on purpose: each upload runs text
# extraction, embedding, and two separate LLM summarizations.
SEED_ENABLED=true
SEED_REMOTE_PDF_URL=https://cdn.bookey.app/files/pdf/book/en/the-wonderful-wizard-of-oz.pdf
SEED_REMOTE_PDF_NAME=the-wonderful-wizard-of-oz.pdf
SEED_MAX_TIME=900
