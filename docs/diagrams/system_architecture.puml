@startuml System_Architecture_Personal_Library
!theme plain
skinparam roundCorner 10
skinparam defaultFontName Inter
skinparam packageStyle rectangle

title Personal Library - Enterprise System Architecture (C4 Container Map)

package "1. Client Tier: SAP UI5 Web Components (UI5 Web Components + TypeScript)" as ClientTier #EBF8FF {
  [ShellBar & Router] as ShellBar
  [ListReportView (Table & FilterBar)] as ListReport
  [ObjectPageView (BibTeX & RAG Chat)] as ObjectPage
  [Observable Stores (appStore, themeStore, i18nStore)] as Stores
  [BackendGateway (REST & Mock Adapters)] as Gateway
  
  ShellBar --> Stores
  ListReport --> Stores
  ObjectPage --> Stores
  Stores --> Gateway
}

package "2. nginx Single Ingress (Port 8088)" as IngressTier #ECFDF5 {
  [nginx Reverse Proxy] as Nginx
}

package "3a. Express Gateway (Port 13000)" as NodeTier #F0FDFA {
  [Express Server (Static SPA Host, Mock Backend)] as ExpressServer
}

package "3b. Spring Boot API Backend (Port 18080)" as JavaTier #F0FDFA {
  [REST API Controllers (/api/v1/*)] as RestControllers
  [Document & BibTeX Extraction Service] as ExtractionEngine
  [Static BPMN 2.0 Export (external Camunda Modeler compatibility, no embedded engine)] as BpmnExport

  RestControllers --> ExtractionEngine
  RestControllers --> BpmnExport
}

package "4. Generative AI & Vector Retrieval Tier" as AITier #FAF5FF {
  [Ollama Llama 3.3 (70B Instruct) - model tag: llama3.2] as LlamaModel
  [Ollama Mistral Large (2411) - model tag: mistral] as MistralModel
  database "Qdrant Vector DB (HTTP 16333 / gRPC 16334)" as QdrantDB
}

package "5. Persistence & Security Tier" as DataTier #FEF3C7 {
  database "MongoDB (DocumentEntity Collection)" as MongoDB
  [Keycloak OIDC (OAuth2 Resource Server)] as Keycloak
  storage "Raw File Store" as FileStorage
}

Gateway -down-> Nginx : "HTTP REST (JSON/Multipart)"
Nginx -down-> RestControllers : "/api/v1/*, /actuator/*"
Nginx -down-> ExpressServer : "everything else"
RestControllers -down-> LlamaModel : "Analytical Prompt"
RestControllers -down-> MistralModel : "Executive Synthesis"
ExtractionEngine -down-> QdrantDB : "Upsert Chunks & Embeddings"
RestControllers -down-> QdrantDB : "Cosine Similarity Top-K"
RestControllers -down-> MongoDB : "Persist DocumentEntity"
RestControllers -down-> Keycloak : "Validate ******"
RestControllers -down-> FileStorage : "Stream Asset"

@enduml
