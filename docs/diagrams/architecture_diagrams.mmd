%% Mermaid C4 Container Diagram for Personal Library
graph TD
    subgraph ClientTier["1. SAP UI5 Web Components Client Tier (UI5 Web Components + TypeScript)"]
        Shell["ShellBarView<br/>(i18n, Theme, Keycloak Session)"]
        ListReport["ListReportView<br/>(Multi-field FilterBar, Paginated Table)"]
        ObjectPage["ObjectPageView<br/>(BibTeX, Dual AI Cards, RAG Chat, Version History & Rollback)"]
        Dialogs["Modal Dialogs<br/>(Upload Pipeline, Version Overwrite, Rollback Confirm, BPMN View)"]
        Stores["Reactive Stores<br/>(appStore, backendStore, themeStore, i18nStore)"]
        Gateway["BackendGateway Facade<br/>(RestBackendAdapter & MockBackendAdapter)"]
        
        Shell --> Stores
        ListReport --> Stores
        ObjectPage --> Stores
        Dialogs --> Stores
        Stores --> Gateway
    end

    subgraph IngressTier["2. nginx Single Ingress (Port 80)"]
        Nginx["nginx Reverse Proxy<br/>(/api/v1/*, /actuator/* -&gt; Spring Boot, everything else -&gt; Express)"]
    end

    subgraph NodeTier["3a. Express Gateway (Port 3000)"]
        Express["Express Server<br/>(Static SPA Host, Mock Backend Adapter, Doc/Diagram Streaming)"]
    end

    subgraph JavaTier["3b. Spring Boot API Backend (Port 8080)"]
        Controllers["REST API Controllers<br/>(/api/v1/documents, /versions, /rollback, /chat, /auth)"]
        Extraction["Extraction & BibTeX Engine<br/>(pdf-parse, LaTeX BNF Formatter, GUID Snapshot Archiving & Rollbacks)"]
        Bpmn["Static BPMN 2.0 Export<br/>(Process_DocumentIngestionRAG.bpmn served/downloaded for external Camunda Modeler use - no embedded engine)"]

        Controllers --> Extraction
        Controllers --> Bpmn
    end

    subgraph AITier["4. Generative AI & Vector Retrieval Tier"]
        Llama["Ollama Llama 3.3 (70B Instruct)<br/>(model tag: llama3.2, Analytical Decomposition & Methodology)"]
        Mistral["Ollama Mistral Large (2411)<br/>(model tag: mistral, Executive Summary & Key Takeaways)"]
        Qdrant["Qdrant Vector Database<br/>(Collection: library_embeddings, HTTP 6333 dashboard / gRPC 6334 Spring AI client)"]
    end

    subgraph DataTier["5. Persistence & Security Tier"]
        MongoDB[("MongoDB Document Store<br/>(Collection: documents, GUID Primary Key)")]
        Keycloak["Keycloak OIDC Server<br/>(Realm: personal-library-realm, JWT Bearer)"]
        FileStore["Raw File Asset Store<br/>(PDF, DOCX, Markdown Files)"]
    end

    Gateway -->|HTTP REST / JSON / Multipart| Nginx
    Nginx -->|/api/v1/*, /actuator/*| Controllers
    Nginx -->|everything else| Express
    Controllers -->|Async Service Task| Llama
    Controllers -->|Async Service Task| Mistral
    Extraction -->|Upsert Chunks & Embeddings| Qdrant
    Controllers -->|Search Top-K Excerpts| Qdrant
    Controllers -->|DocumentEntity CRUD| MongoDB
    Controllers -->|OAuth2 ****** Validation| Keycloak
    Controllers -->|Download / Stream| FileStore
