{
  "name": "personal-library",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "compose": "./scripts/compose.sh",
    "config:check": "./scripts/check-config.sh",
    "rebuild": "./scripts/rebuild.sh",
    "rebuild:deep": "./scripts/rebuild.sh --deep --no-cache",
    "clean:generated-docs": "./scripts/rebuild.sh --deep --clean-only",
    "ops:factory-reset": "./scripts/rebuild.sh --purge-all",
    "docs:ts": "typedoc",
    "docs:java": "tsx scripts/generate-javadoc.ts",
    "docs:pages": "tsx scripts/generate-doc-pages.ts",
    "docs": "typedoc && tsx scripts/generate-javadoc.ts && tsx scripts/generate-doc-pages.ts",
    "diagrams": "tsx scripts/generate-diagrams.ts && tsx scripts/generate-architecture-diagrams.ts && tsx scripts/generate-uml-diagrams.ts && tsx scripts/generate-architecture-from-mmd.ts && tsx scripts/generate-mindmap.ts && tsx scripts/generate-entity-diagrams.ts && tsx scripts/generate-ontology-diagrams.ts && tsx scripts/generate-rag-diagrams.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdf-parse": "^1.1.5",
    "@ui5/webcomponents": "^2.27.2",
    "@ui5/webcomponents-base": "^2.27.2",
    "@ui5/webcomponents-fiori": "^2.27.2",
    "@ui5/webcomponents-icons": "^2.27.2",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "markdown-it": "^15.0.2",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
